# ========================================
# 🔐 NEXT.JS ENVIRONMENT VARIABLES
# ========================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Stripe (if using payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# AWS S3 (if using file uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Email Service (SendGrid, Gmail, etc)
SENDGRID_API_KEY=SG.xxx
SMTP_EMAIL=noreply@example.com
SMTP_PASSWORD=password

# Third-party APIs
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=

# Analytics
NEXT_PUBLIC_GA_ID=UA-xxx
NEXT_PUBLIC_SEGMENT_KEY=

# Feature Flags
NEXT_PUBLIC_FEATURE_BETA=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Debug (Development only)
DEBUG=*
NODE_ENV=development

# ========================================
# 📝 INSTRUCTIONS:
# ========================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your actual values for each variable
# 3. Keep .env.local out of git (already in .gitignore)
# 4. Variables prefixed with NEXT_PUBLIC_ are available in browser
# 5. Other variables are server-side only
# ========================================
